{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovrstudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "ovrstudio-cms",
      "database_id": "f8a253c1-a8ba-4b83-b4ae-ebe41683a0a8"
    }
  ]
}